# PostgreSQL接続文字列（Fly Postgresを使う場合は `fly postgres attach` が自動でセットする）
DATABASE_URL=postgres://postgres:password@localhost:5432/accounting_agent

# OCR用 Google Gemini APIキー（未設定でもサーバーは起動するが、OCRエンドポイントは503を返す）
GEMINI_API_KEY=

# アップロードされたレシート・請求書ファイルの保存先（Fly volumeをマウントしたパスを指定）
UPLOAD_DIR=./data/uploads

PORT=3000
